[Unit]
Description=PM-VPN PostgreSQL managed by Patroni
Requires=docker.service wg-quick@vpn-cluster.service
Wants=pm-vpn-etcd.service
After=docker.service wg-quick@vpn-cluster.service pm-vpn-etcd.service

[Service]
Type=simple
ExecStart=/usr/bin/docker run --rm --name pm-vpn-postgres --network host --init --mount type=bind,src=/var/lib/pm-vpn-postgres,dst=/cluster --mount type=bind,src=/etc/pm-vpn-cluster/patroni.json,dst=/etc/patroni/config.yml,readonly pm-vpn-patroni:stage
ExecStop=/usr/bin/docker stop --time 20 pm-vpn-postgres
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
