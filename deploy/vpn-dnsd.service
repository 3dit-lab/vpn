[Unit]
Description=Authoritative DNS for the VPN zone (alive servers only)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/vpn-dns/vpn-dnsd.py /etc/vpn-dnsd.json
Restart=always
RestartSec=3
User=vpndns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
